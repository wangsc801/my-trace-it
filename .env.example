# Docker 模式环境变量示例。复制为 .env 后按需填写：
#   cp .env.example .env

# 后端管理员初始密码（必填，缺失则 docker compose 直接报错）
ADMIN_PASSWORD=change-me

# 管理员账号（可选，默认 admin）
ADMIN_USERNAME=admin

# PostgreSQL（db 服务）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=my_trace_it

# JWT 签名密钥（生产请改为 ≥32 字节的随机字符串）
JWT_SECRET=please-change-this-to-a-long-random-secret-2026

# 前端构建时注入的后端地址。默认留空 = 同源（nginx 在同一端口反代 /api 到后端，
# 适配任意访问域名/IP）。仅当需要前端直连单独的后端时再填具体地址。
VITE_API_BASE_URL=